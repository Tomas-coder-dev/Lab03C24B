<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Estudiantes" Height="540" Width="700"
        Background="#e9f8ff" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Buscador de estudiante -->
        <Border Grid.Row="0" CornerRadius="5" BorderBrush="#3796d6" BorderThickness="1" Background="#e0f3fa" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Buscar estudiante:" FontWeight="Bold" Foreground="#3796d6" Margin="0,0,8,0"/>
                <TextBox x:Name="txtNombre" Width="200" Margin="0,0,8,0"/>
                <Button Content="Buscar" Click="BtnBuscar_Click" Width="80" Background="#3796d6" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- DataGrid de estudiantes -->
        <Border Grid.Row="1" CornerRadius="5" BorderBrush="#3796d6" BorderThickness="1" Background="#e0f3fa" Padding="12">
            <StackPanel>
                <TextBlock Text="Listado de Estudiantes" FontWeight="Bold" Foreground="#3796d6" FontSize="15" Margin="0,0,0,8"/>
                <DataGrid x:Name="dgEstudiantes" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowBackground="#f6fcff"
                          AlternatingRowBackground="#d0edfa"
                          GridLinesVisibility="None"
                          ColumnHeaderHeight="32"
                          RowHeight="28"
                          FontSize="13"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="70"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding FirstName}" Width="170"/>
                        <DataGridTextColumn Header="Apellido" Binding="{Binding LastName}" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>